.action-menu {
    position: absolute;
    background-color: rgba(20, 20, 20, 0.95);
    border-radius: 6px;
    padding: 6px;
    flex-direction: column;
}

.button-container {
    flex-direction: column;
}

.action-button {
    height: 30px;
    width: 125px;
    padding-left: 20px;
    justify-content: center;
}

.action-button:selected {
    background-color: rgba(255, 255, 255, 0.1);
}

.selection-indicator {
    position: absolute;
    left: 2px;
    width: 10px;
    height: 10px;
    background-color: white;
    border-radius: 5px;
    visibility: hidden;
}

:root {
    position: absolute;
    flex-grow: 1;
    width: 100%;
    height: 100%;
}
