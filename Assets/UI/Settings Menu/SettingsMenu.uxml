<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Assets/UI/Pause%20Menu/PauseMenu.uss?fileID=7433441132597879392&amp;guid=64087fb525a213647b687a8887def4c8&amp;type=3#PauseMenu" />
    <ui:VisualElement name="Panel" class="panel" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.51); justify-content: flex-start; align-items: center; align-self: auto; align-content: auto;">
        <ui:VisualElement name="Background" style="flex-grow: 1; width: 80%; height: 80%; top: 10%; bottom: 10%; right: auto; left: auto; position: absolute; justify-content: flex-start; align-items: center; background-color: rgb(0, 0, 0); color: rgb(255, 255, 255); -unity-background-image-tint-color: rgb(0, 0, 0);">
            <ui:Label text="Settings" style="align-items: flex-start; left: 0%; top: 5%; font-size: 64px;" />
            <ui:VisualElement name="InnerBox" style="flex-grow: 1; right: 5%; bottom: 5%; left: 5%; top: 10%; align-items: center; position: absolute;">
                <ui:Slider label="Master Volume" value="42" high-value="100" fill="true" show-input-field="false" direction="Horizontal" name="MasterVolumeSlider" style="right: 10%; left: 10%; top: auto; position: absolute; width: 80%; height: auto; min-height: 24px; font-size: 48px;" />
                <ui:Slider label="Music Volume" value="42" high-value="100" fill="true" show-input-field="false" direction="Horizontal" name="MusicVolumeSlider" style="right: 10%; left: 10%; top: 7%; position: absolute; width: 80%; height: auto; min-height: 24px; font-size: 48px;" />
                <ui:Slider label="FX Volume" value="42" high-value="100" fill="true" show-input-field="false" direction="Horizontal" name="FXVolumeSlider" style="right: 10%; left: 10%; top: 14%; position: absolute; width: 80%; height: auto; min-height: 24px; font-size: 48px;" />
                <ui:Slider label="Gameplay Volume" value="42" high-value="100" fill="true" show-input-field="false" direction="Horizontal" name="GameplayVolumeSlider" style="right: 10%; left: 10%; top: 21%; position: absolute; width: 80%; height: auto; min-height: 24px; font-size: 48px;" />
                <ui:Slider label="Zoom Level" value="42" high-value="100" fill="true" show-input-field="false" direction="Horizontal" name="ZoomLevelSlider" style="right: 10%; left: 10%; top: 28%; position: absolute; width: 80%; height: auto; min-height: 24px; font-size: 48px;" />
                <ui:Slider label="Game Speed" value="42" high-value="100" fill="true" show-input-field="false" direction="Horizontal" name="GameSpeedSlider" style="right: 10%; left: 10%; top: 35%; position: absolute; width: 80%; height: auto; min-height: 24px; font-size: 48px;" />
                <ui:Button text="back to game" name="BackButton" style="position: absolute; top: 42%;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
