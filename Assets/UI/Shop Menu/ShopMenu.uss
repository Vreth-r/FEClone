.overlay {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.55);
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.shop-card {
    width: 720px;
    height: 520px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 18px;
    background-color: rgba(30, 35, 55, 0.95);
    border-radius: 12px;
}

.shop-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: upper-center;
    margin-bottom: 8px;
}

.gold-label {
    color: rgb(240, 220, 120);
    -unity-text-align: lower-right;
    margin-bottom: 8px;
}

.tab-content {
    display: flex;
    flex-direction: column;
    top: 6px;
    padding: 6px;
    overflow: scroll;
    flex-grow: 1;
}

.item-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 64px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgba(60, 70, 110, 0.7);
    border-radius: 6px;
}

.item-icon {
    width: 48px;
    height: 48px;
    margin-right: 8px;
}

.item-info {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.item-name {
    font-size: 14px;
    -unity-font-style: bold;
    color: white;
}

.item-desc {
    font-size: 12px;
    color: rgb(200, 200, 200);
}

.item-action {
    width: 90px;
}

:root {
    width: 100%;
    height: 100%;
}
